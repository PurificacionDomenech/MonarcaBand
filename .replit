modules = ["web", "python-3.12", "postgresql-16", "nodejs-20"]
[agent]
expertMode = true
integrations = ["github:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["glibcLocales", "libxcrypt"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uvicorn main:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[deployment]
deploymentTarget = "vm"
run = ["gunicorn", "--bind=0.0.0.0:8000", "--reuse-port", "-w", "1", "-k", "uvicorn.workers.UvicornWorker", "main:app"]

[userenv]

[userenv.shared]
SUPABASE_URL = "https://mscvlzxxuawwmltsdxxb.supabase.co"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
